# Local development (Docker): mongodb://127.0.0.1:27017/formora_dev
# Production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/formora
MONGODB_URI=

# Auth.js. Generate with: npx auth secret  (or any 32+ random characters)
AUTH_SECRET=
# Needed when running `next start` locally; Vercel sets this up itself.
AUTH_TRUST_HOST=true

# How sign-in emails are sent.
#   console: print the link in the terminal (local development only; never set on Vercel)
#   resend:  send real email through Resend (production)
EMAIL_TRANSPORT=console
# Only when EMAIL_TRANSPORT=resend:
RESEND_API_KEY=
EMAIL_FROM=Formora <login@your-domain.example>

# The app's own public address, used to build links inside emails. Never
# trusted from the incoming request (see lib/app-origin.ts). Required in
# production; optional locally (falls back to the dev server's own origin).
APP_ORIGIN=

# Google sign-in for creators. Optional: leave both blank to hide the Google
# button everywhere. Create credentials at https://console.cloud.google.com/
# (APIs & Services > Credentials > OAuth client ID > Web application), with
# an authorized redirect URI of <APP_ORIGIN>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
