# Local development (Docker): mongodb://127.0.0.1:27017/formora_dev
# Production (Atlas): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/formora
MONGODB_URI=

# Auth.js. Generate with: npx auth secret  (or any 32+ random characters)
AUTH_SECRET=
# Needed when running `next start` locally; Vercel sets this up itself.
AUTH_TRUST_HOST=true

# How sign-in emails are sent.
#   console: print the link in the terminal (local development only; never set on Vercel)
#   resend:  send real email through Resend (production)
EMAIL_TRANSPORT=console
# Only when EMAIL_TRANSPORT=resend:
RESEND_API_KEY=
EMAIL_FROM=Formora <login@your-domain.example>
